<joint name="arm_joint_1" type="continuous">
  <origin xyz="-0.1 0.0 0.125" rpy="0 0 0"/>
  <parent link="chassis"/>
  <child link="link_1_1"/>
  <axis xyz="0.0 0.0 1.0"/>
</joint>

<joint name="arm_joint_2" type="continuous">
  <origin xyz="0.1 0.0 0.24" rpy="0 0 0"/>
  <parent link="link_1_1"/>
  <child link="link_2_1"/>
  <axis xyz="1.0 0.0 0.0"/>
</joint>

<joint name="arm_joint_3" type="continuous">
  <origin xyz="-0.0325 -0.0 -0.0825" rpy="0 0 0"/>
  <parent link="link_2_1"/>
  <child link="link_3_1"/>
  <axis xyz="0.0 0.0 -1.0"/>
</joint>

<joint name="arm_joint_4" type="continuous">
  <origin xyz="0.2615 0.0 -0.12" rpy="0 0 0"/>
  <parent link="link_3_1"/>
  <child link="link_4_1"/>
  <axis xyz="1.0 0.0 0.0"/>
</joint>

<joint name="arm_joint_5" type="continuous">
  <origin xyz="-0.175 0.0 0.12" rpy="0 0 0"/>
  <parent link="link_4_1"/>
  <child link="link_5_1"/>
  <axis xyz="0.0 0.0 1.0"/>
</joint>

<joint name="arm_joint_6" type="continuous">
