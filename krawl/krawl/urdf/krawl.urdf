  <parent link="gripper"/>
  <child link="klaw_1_1"/>
  <axis xyz="0.0 0.0 1.0"/>
  <limit upper="0.0" lower="-3.228859" effort="100" velocity="100"/>
</joint>

<joint name="gripper_2" type="revolute">
